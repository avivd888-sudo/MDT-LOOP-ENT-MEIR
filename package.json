{
  "name": "ent-mdt",
  "version": "0.1.0",
  "private": true,
  "description": "ENT-MDT — Head & Neck oncology multidisciplinary team platform (clickable prototype, demo data only)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "icons": "node single/icons.mjs",
    "single": "npm run build && node single/build.mjs",
    "docs": "npm run single && cp single/mdt-loop.html docs/app.html",
    "preview": "node preview.mjs",
    "verify": "node verify.mjs",
    "test:sim": "node test/run.mjs",
    "test:e2e": "node test/e2e-sim.mjs",
    "test:golive": "node test/golive.mjs",
    "test:all": "npm run test:sim && npm run verify && npm run test:e2e && npm run test:golive"
  },
  "dependencies": {
    "@fontsource/heebo": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/rubik": "^5.3.0",
    "material-symbols": "^0.46.0",
    "next": "^15.5.23",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "esbuild": "^0.28.2",
    "playwright": "^1.62.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.3"
  }
}
